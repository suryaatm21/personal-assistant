# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — Project Settings > API
# Use the SERVICE ROLE key (not anon). Server-side only; never ship to a browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Twilio — Console Dashboard
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Defaults — override per deployment.
DEFAULT_TIMEZONE=America/New_York
ANTHROPIC_MODEL=claude-haiku-4-5
MAX_TOOL_ITERATIONS=5

# Local development only — bypasses Twilio signature validation so you can
# curl the webhook directly. NEVER set this to true in production.
SKIP_TWILIO_SIGNATURE_VALIDATION=false
